{
  "name": "spotcheck",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-data.ts",
    "dev": "next dev",
    "prebuild": "node scripts/copy-data.ts",
    "build": "next build",
    "postbuild": "node scripts/clean-out.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate-data",
    "fetch-data": "node scripts/fetch/run.ts",
    "validate-data": "node scripts/fetch/validate.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.2"
  },
  "type": "module",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
